       IDENTIFICATION DIVISION.
       PROGRAM-ID. STUDENT-MARKS-PROCESS.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT STUDENT-FILE ASSIGN TO KSDS-FILE
               ORGANIZATION IS INDEXED
               ACCESS MODE IS SEQUENTIAL
               RECORD KEY IS STU-HT
               FILE STATUS IS FS1.

       DATA DIVISION.
       FILE SECTION.
       FD STUDENT-FILE.
       01 STUDENT-RECORD.
           05 STU-HT PIC X(10).
           05 STU-F-NAME PIC X(20).
           05 STU-L-NAME PIC X(20).
           05 STU-FATHER-NAME PIC X(20).
           05 STU-DOB PIC X(10).
           05 STU-AGE PIC 99.
           05 STU-MARKS OCCURS 5 TIMES PIC 99.
           05 STU-TOTAL PIC 999.

       WORKING-STORAGE SECTION.
       01 WS-MAX-AGE PIC 99 VALUE 0.
       01 WS-MIN-AGE PIC 99 VALUE 99.
       01 WS-MAX-MARKS PIC 999 VALUE 0.
       01 WS-MIN-MARKS PIC 999 VALUE 999.
       01 WS-RECORD-COUNT PIC 9(5) VALUE 0.
       01 WS-DUP-MAX-AGE PIC 9(5) VALUE 0.
       01 WS-DUP-MIN-AGE PIC 9(5) VALUE 0.
       01 WS-DUP-MAX-MARKS PIC 9(5) VALUE 0.
       01 WS-DUP-MIN-MARKS PIC 9(5) VALUE 0.

       PROCEDURE DIVISION.
       MAIN-PROCEDURE.
           OPEN INPUT STUDENT-FILE
           IF FS1 NOT = '00'
               DISPLAY 'OPEN FILE ERROR: ' FS1
               STOP RUN
           END-IF.

           PERFORM READ-RECORDS UNTIL FS1 = '10'.

           DISPLAY 'TOTAL RECORDS READ: ' WS-RECORD-COUNT
           DISPLAY 'MAXIMUM AGE: ' WS-MAX-AGE ' DUPLICATE COUNT: ' WS-DUP-MAX-AGE
           DISPLAY 'MINIMUM AGE: ' WS-MIN-AGE ' DUPLICATE COUNT: ' WS-DUP-MIN-AGE
           DISPLAY 'MAXIMUM MARKS: ' WS-MAX-MARKS ' DUPLICATE COUNT: ' WS-DUP-MAX-MARKS
           DISPLAY 'MINIMUM MARKS: ' WS-MIN-MARKS ' DUPLICATE COUNT: ' WS-DUP-MIN-MARKS.

           CLOSE STUDENT-FILE
           STOP RUN.

       READ-RECORDS.
           READ STUDENT-FILE INTO STUDENT-RECORD
               AT END MOVE '10' TO FS1
           END-READ.

           IF FS1 = '00'
               ADD 1 TO WS-RECORD-COUNT
               PERFORM COMPUTE-AGE
               PERFORM COMPUTE-MARKS
           END-IF.

       COMPUTE-AGE.
           IF STU-AGE > WS-MAX-AGE
               MOVE STU-AGE TO WS-MAX-AGE
               MOVE 1 TO WS-DUP-MAX-AGE
           ELSE IF STU-AGE = WS-MAX-AGE
               ADD 1 TO WS-DUP-MAX-AGE
           END-IF.

           IF STU-AGE < WS-MIN-AGE
               MOVE STU-AGE TO WS-MIN-AGE
               MOVE 1 TO WS-DUP-MIN-AGE
           ELSE IF STU-AGE = WS-MIN-AGE
               ADD 1 TO WS-DUP-MIN-AGE
           END-IF.

       COMPUTE-MARKS.
           MOVE 0 TO STU-TOTAL
           PERFORM VARYING I FROM 1 BY 1 UNTIL I > 5
               ADD STU-MARKS(I) TO STU-TOTAL
           END-PERFORM.

           IF STU-TOTAL > WS-MAX-MARKS
               MOVE STU-TOTAL TO WS-MAX-MARKS
               MOVE 1 TO WS-DUP-MAX-MARKS
           ELSE IF STU-TOTAL = WS-MAX-MARKS
               ADD 1 TO WS-DUP-MAX-MARKS
           END-IF.

           IF STU-TOTAL < WS-MIN-MARKS
               MOVE STU-TOTAL TO WS-MIN-MARKS
               MOVE 1 TO WS-DUP-MIN-MARKS
           ELSE IF STU-TOTAL = WS-MIN-MARKS
               ADD 1 TO WS-DUP-MIN-MARKS
           END-IF.
